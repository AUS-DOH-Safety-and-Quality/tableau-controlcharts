<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="au.gov.wa.health.funnels" extension-version="0.0.1">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Funnel Plots for Tableau</description>
    <author name="HQIU - WA Health" email="safetyandquality@health.wa.gov.au" organization="AUS-DOH-Safety-and-Quality" website="https://github.com/AUS-DOH-Safety-and-Quality"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8765/funnels/index.html</url>
    </source-location>
    <icon/>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
    <encoding id="key">
      <display-name>Groups</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="text"/>
    </encoding>
    <encoding id="numerators">
      <display-name>Numerator</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-y"/>
    </encoding>
    <encoding id="denominators">
      <display-name>Denominator</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-x"/>
    </encoding>
    <encoding id="labels">
      <display-name>Value Labels</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
        <role-type>discrete-measure</role-type>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-l"/>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Funnel</text>
    </resource>
  </resources>
</manifest>
