{
  "extends": "powerbi-visuals-core/config/tsconfig.visual.json",
  "compilerOptions": {
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "types": ["@tableau/extensions-api-types"],
    "paths": {
      "powerbi-spc/*": ["./node_modules/powerbi-spc/src/*"],
      "powerbi-funnels/*": ["./node_modules/powerbi-funnels/src/*"]
    }
  },
  "include": ["src/**/*", "spc/**/*.ts", "funnels/**/*.ts"]
}
